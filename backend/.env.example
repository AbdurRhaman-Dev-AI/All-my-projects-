# MediaVault Backend Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional path to Netscape-format cookies.txt for private/logged-in posts
# COOKIES_FILE=./cookies.txt

# Storage paths (relative to backend/ or absolute)
STORAGE_DIR=../storage
DATABASE_URL=sqlite+aiosqlite:///../storage/mediavault.db
